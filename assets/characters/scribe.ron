// The Scribe: a man with long brown hair, an olive corduroy blazer over a white shirt with a red tie, mustard trousers
// and black boots, and a book on his belt at all times.
// Light: very fast stabs with a quill (arms alternate). The third hit of a combo is the book: he opens it and writes
//        "<enemy> understood the futility of life." in a speech bubble; a blue particle then flies at the enemy and can't
//        be dodged or blocked. It hurts a little and, for 2.5 seconds, every attack the enemy starts costs them health.
// Heavy: he reads from the book and writes, purple sparks flying off the pen, "A hail of knives poured onto <enemy>":
//        a wide portal opens above where the enemy stands and knives pour out of it over a wide stretch of ground.
//        Move out from under it. Once the knives start, being hit does not interrupt it. Up close (within 80 px) it is a pool
//        of water and a sperm whale's head that bites instead (within 120 px), a third wider than it first was.
// Special: he writes three strokes, "... then Jesus appeared": Jesus appears in the sky and a beam of light sweeps from
//        in front of where the enemy stood to behind it. Get out of its way (or roll through it). Once the beam
//        starts, being hit does not interrupt it.
// See ayz.ron for what each field means; `futility`, `say`, `sparks`, `beam` and the lob fields `over_target`,
// `spread` and `unblockable` are explained in src/sim/data.rs.
(
    name: "The Scribe",
    subtitle: Some("Author of many-a-fanfic"),
    // what Light, Heavy and Special do, shown in the character select
    blurbs: ["Fast quill stabs (three quills from afar), then a logical fallacy that hurts and makes them bleed.", "Knives pour from a wide portal over the enemy; up close a sperm whale rises from a pool and bites.", "Writes \"then Jesus appeared\": a beam of light sweeps across where the enemy stands. Get out of its way."],
    sprites: Some("scribe"),
    color: (0.85, 0.90, 0.40),
    walk_speed: 231,
    // a dash at the enemy is made behind the book, held up in front: hits are blocked while it lasts
    dash_shield: true,
    jump_speed: 1050,
    moves: [
        // very fast quill stabs
        (name: "Quill Jab", blocked_stun: Some((shots: 3, stun: 72)), sfx: (cast: Some("quill")), button: Light, crouching: false, anim: Punch, walk_pct: 70,
         startup: 5, active: 3, recovery: 6, damage: 25, hitstun: 9, blockstun: 5, knockback: 1, hitstop: 2,
         hitbox: (x: 8, y: 30, w: 27, h: 12)),
        (name: "Low Quill", blocked_stun: Some((shots: 3, stun: 72)), sfx: (cast: Some("quill")), button: Light, crouching: true, anim: Soft, walk_pct: 0,
         startup: 6, active: 3, recovery: 8, damage: 16, hitstun: 9, blockstun: 5, knockback: 1, hitstop: 2,
         hitbox: (x: 8, y: 0, w: 27, h: 12)),
        // far away the quill is thrown instead: one a press, almost no reload between them, so mashing Light throws them in
        // threes; then a short reload before the next three
        (name: "Quill Throw", blocked_stun: Some((shots: 3, stun: 72)), sfx: (cast: Some("quill"), launch: Some("knife_throw")), button: Light, crouching: false, anim: Punch, walk_pct: 40, beyond: Some(58),
         burst_shots: 3, burst_reload: 26,
         startup: 3, active: 1, recovery: 3, damage: 20, hitstun: 9, blockstun: 6, knockback: 1, hitstop: 2,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 18, y: 32, aim_y: 32, travel_frames: 1, lifetime: 50, size: (14, 6), image: Some("quill"), speed: 6, steer: true, homing_turn: 4))),
        // a dash away from the enemy (a double tap backwards) is a step back with a pencil thrown at them
        (name: "Pencil Throw", blocked_stun: Some((shots: 3, stun: 72)), sfx: (cast: Some("quill"), launch: Some("knife_throw")), button: Light, crouching: false, anim: Punch, walk_pct: 0, dash_throw: true, lunge: -450, cooldown: 40,
         startup: 6, active: 2, recovery: 12, damage: 18, hitstun: 10, blockstun: 6, knockback: 1, hitstop: 2,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 18, y: 36, aim_y: 36, travel_frames: 1, lifetime: 60, size: (14, 4), image: Some("pencil"), speed: 7))),
        // the third hit of a combo: the book. The blue particle homes in on the enemy, can't be blocked, hurts and makes them bleed,
        // and when it lands he gets plot armour: a blue bubble nothing gets through, for 2.5 seconds.
        (name: "Logical Fallacy", sfx: (cast: Some("quill"), launch: Some("dark_cast"), hit: Some("curse")), button: Light, crouching: false, anim: Write, walk_pct: 0, finisher_move: true,
         bleed: Some((damage: 5, every: 15, ticks: 6)), plot_armour: 150, say: Some("{enemy} committed a logical fallacy."),
         startup: 40, active: 2, recovery: 18, damage: 53, hitstun: 12, blockstun: 6, knockback: 0, hitstop: 4,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 18, y: 30, aim_y: 30, travel_frames: 1, lifetime: 150, size: (8, 8), image: Some("orb"), summon_image: Some("none"),
                           homing: true, homing_turn: 100, detonate: 7, speed_tenths: 75, unblockable: true))),
        (name: "Air Quill", blocked_stun: Some((shots: 3, stun: 72)), sfx: (cast: Some("quill")), button: Light, crouching: false, air: true, anim: Soft, walk_pct: 100,
         startup: 5, active: 9, recovery: 9, damage: 19, hitstun: 9, blockstun: 5, knockback: 1, hitstop: 2,
         hitbox: (x: 6, y: 0, w: 27, h: 28)),
        // the hail: he writes (purple sparks), a portal opens over the enemy, knives pour out of it
        (name: "Hail of Knives", sfx: (cast: Some("portal_open"), launch: Some("knife_throw"), hit: Some("knife_hit")), button: Heavy, crouching: false, anim: Write, walk_pct: 0, cooldown: 360, shared_cooldown: true,
         say: Some("A hail of knives poured onto {enemy}"), sparks: Some((0.72, 0.3, 1.0)),
         volley: 48, volley_gap: 2, guard_hits: Some(90), committed: true,
         startup: 26, active: 4, recovery: 62, damage: 11, hitstun: 6, blockstun: 4, knockback: 1, hitstop: 1,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 0, y: 0, aim_y: 0, travel_frames: 14, lifetime: 40, size: (6, 12), image: Some("knife"), summon_image: Some("portal"),
                           lob: true, over_target: true, spread: 130, splash_radius: 12, moon_height: 120, lock_frame: 12))),
        // up close the heavy is a pool of water opening under the enemy, and a sperm whale's head coming up out of it to bite
        (name: "Sperm Whale", sfx: (cast: Some("portal_open"), hit: Some("bite")), button: Heavy, crouching: false, anim: Write, walk_pct: 0, cooldown: 540, shared_cooldown: true, within: Some(108),
         say: Some("I just read this book..."), sparks: Some((0.3, 0.6, 1.0)), guard_hits: Some(2), committed: true,
         beam: Some((lock_frame: 12, lead: 0, sweep: 0, width: 86, height: 62, whale: true)),
         startup: 39, active: 6, recovery: 51, damage: 81, hitstun: 30, blockstun: 16, knockback: 5, hitstop: 8,
         hitbox: (x: 0, y: 0, w: 0, h: 0)),
        // three strokes, then Jesus and his beam
        (name: "Then Jesus Appeared", sfx: (cast: Some("holy_cast"), hit: Some("holy_hit")), button: Special, crouching: false, anim: Write, walk_pct: 0, guard_hits: Some(2), committed: true,
         say: Some("... then Jesus appeared"), sparks: Some((1.0, 0.92, 0.5)),
         beam: Some((lock_frame: 24, lead: 14, sweep: 72, width: 26, height: 120)),
         startup: 34, active: 44, recovery: 30, damage: 132, hitstun: 40, blockstun: 20, knockback: 6, hitstop: 10,
         hitbox: (x: 0, y: 0, w: 0, h: 0)),
    ],
)
