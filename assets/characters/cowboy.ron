// Cowboy From Hell: completely bald under a cowboy hat, a dark brown ribbed tank top, silver chain and earrings, grey
// jeans, big brown cowboy boots with spurs and a whale tattoo on his left arm.
// Light: the Gunslinger's lights (a finger-gun shot, a low slap, an aimed shot in the air). The combo is two shots and
//        then a lasso that pulls the opponent in a little and stuns them. His shots reach about 300 px (50 frames at 6 px).
// Heavy: he fires both finger guns at the ground (the splash hurts anyone close), the recoil launches him up, and at the
//        top (three times as high as before, then he floats down slowly) he shoots four quick bullets (half as strong as the
//        Gunslinger's) at the floor where the enemy will be, never at the body, so the enemy can still jump them; any two
//        that land, blocked or not, break the guard. He can
//        use it while being hit to get out of a combo, but not out of a long stun (40 frames or more) or a hold.
// Special: he throws his hat. It sits on his head the whole fight and glows once the meter is full. It is gone while
//        the throw itself recharges. Where it lands it puts the curse on the opponent: a glowing blue ring split into a
//        left and a right half. Hitting them with any other attack from the left removes the left half, from the right
//        the right half; with both gone the ring squeezes shut and deals the special's damage.
// Shooting in the air leans him back (air_shot_tilt: separate drawings, three stages of the lean).
// See ayz.ron for what each field means; leap / leap_vx / radial / volley_delay / shot_damage / curse are explained in
// src/sim/data.rs.
(
    name: "Cowboy From Hell",
    subtitle: Some("Proud owner of real cattle"),
    // what Light, Heavy and Special do, shown in the character select
    blurbs: ["Two finger-gun shots, then a lasso that pulls the enemy in and stuns them.", "Fires at the ground and launches himself up, then shoots three bullets at the floor below.", "Throws his hat to curse the enemy: hit them from both sides to break the ring before it squeezes."],
    sprites: Some("cowboy"),
    color: (0.85, 0.58, 0.32),
    walk_speed: 210,
    jump_speed: 1050,
    // the CPU rushes in: dashes, leaps and hops towards the opponent
    cpu_rush: true,
    // a third less health than the others (667 of 1000)
    health: Some(667),
    // the special meter fills at 43% of the normal rate
    meter_gain_pct: Some(43),
    special_mark: Some(GlowingHat),
    // the Cowboy's own voice, on top of the game's generic sounds (assets/sfx/voice_cowboy_*.wav, made by tools/voice_prep.py --trim)
    voice: (attack_voice_channel: true, dash: Some("voice_cowboy_dash"), hurt: Some("voice_cowboy_hurt"), ko: Some("voice_cowboy_death"), block: Some("voice_cowboy_block"),
            guard_break: Some("voice_cowboy_stunned"), smash: Some("voice_cowboy_stomp"), win: Some("voice_cowboy_win")),
    air_shot_tilt: true,
    moves: [
        // the combo: shot, shot, lasso
        (name: "Finger Shot", sfx: (cast: Some(""), launch: Some("shot_pistol"), voice: Some("voice_cowboy_light")), button: Light, crouching: false, anim: Punch, walk_pct: 60, combo_step: Some(0),
         startup: 6, active: 2, recovery: 6, damage: 26, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 3,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 30, y: 44, aim_y: 44, travel_frames: 1, lifetime: 50, size: (8, 6), image: Some("bullet"), speed: 6))),
        (name: "Finger Shot 2", sfx: (cast: Some(""), launch: Some("shot_pistol")), button: Light, crouching: false, anim: Punch, walk_pct: 60, combo_step: Some(1),
         startup: 6, active: 2, recovery: 6, damage: 26, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 3,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 30, y: 44, aim_y: 44, travel_frames: 1, lifetime: 50, size: (8, 6), image: Some("bullet"), speed: 6))),
        // third hit: the lasso drags the opponent in a little and leaves them stunned
        (name: "Lasso", sfx: (cast: Some("whip_crack"), voice: Some("voice_cowboy_combo")), button: Light, crouching: false, anim: Punch, walk_pct: 0, finisher_move: true,
         pull_foe: true, pull_gap: 38, assist: 8, rope: true,
         startup: 11, active: 4, recovery: 16, damage: 30, hitstun: 48, blockstun: 10, knockback: 0, hitstop: 5,
         hitbox: (x: 10, y: 26, w: 120, h: 18)),
        (name: "Low Slap", button: Light, crouching: true, anim: Soft, walk_pct: 0,
         startup: 10, active: 3, recovery: 9, damage: 24, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 12, y: 0, w: 26, h: 12)),
        // the one aimed shot, from the air
        (name: "Air Shot", sfx: (cast: Some(""), launch: Some("shot_pistol"), voice: Some("voice_cowboy_light")), button: Light, crouching: false, air: true, anim: Hard, walk_pct: 100,
         startup: 15, active: 2, recovery: 14, damage: 45, hitstun: 18, blockstun: 12, knockback: 3, hitstop: 6,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 26, y: 26, aim_y: 28, travel_frames: 12, lifetime: 40, size: (10, 6), image: Some("bullet"), aimed: true))),
        // both guns at the ground (the splash), up he goes, then the volley at the enemy; needs the ground
        (name: "Gun Boost", sfx: (cast: Some("shot_shotgun"), launch: Some("shot_pistol"), voice: Some("voice_cowboy_heavy_jump"), launch_voice: Some("voice_cowboy_heavy_shoot")), button: Heavy, crouching: false, anim: Boost, walk_pct: 0,
         leap: 1296, leap_vx: 40, slow_fall: 20, escape: true, radial: true, guard_hits: Some(2), hits_break_guard: true, cooldown: 200,
         committed: true, commit_at: Some(3),
         volley: 4, volley_gap: 6, volley_delay: 24, shot_damage: Some(11),
         startup: 14, active: 5, recovery: 55, damage: 44, hitstun: 22, blockstun: 12, knockback: 5, hitstop: 7,
         hitbox: (x: -48, y: 0, w: 96, h: 30),
         projectile: Some((x: 30, y: 30, aim_y: 30, travel_frames: 8, lifetime: 45, size: (16, 10), image: Some("bullet"), aimed: true, aim_ground: true, spread: 40))),
        // the hat: it flies at the enemy and the curse starts where it lands (the damage comes when the ring closes)
        (name: "Hell's Hat", sfx: (cast: Some("fire_cast"), launch: Some("fire_burst"), hit: Some("fire_hit"), voice: Some("voice_cowboy_ult")), button: Special, crouching: false, anim: Summon, walk_pct: 0, cooldown: 420,
         curse: Some((duration: 420, squeeze: 24)),
         startup: 22, active: 3, recovery: 22, damage: 200, hitstun: 24, blockstun: 16, knockback: 0, hitstop: 8,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 20, y: 58, aim_y: 40, travel_frames: 30, lifetime: 90, size: (22, 14), image: Some("hat"), summon_image: Some("none"), spin: true))),
    ],
)
