// Junkhead: a whip fighter. Looks are the Cowboy From Hell's with a black tank top, red tattoo, plain shoes and his
// own head; the drawings for his moves are still the cowboy's placeholders.
//
// Light: whip from the right, whip from the left (arms alternate while you spam it), and a jump kick as the third hit
//        of a combo (the finisher). If the finisher lands, his next standing whip has extra reach, once. Crouching
//        Light is a low whip; in the air Light spins the whip around him from head to legs. Up to three air attacks
//        per jump: a connected air light can chain into another one or into the air Heavy (the whip pulls him through
//        the air towards the opponent). The special works in the air too: he hangs there while he spins and the lash
//        still goes high or low at the floor.
// Heavy: lash out, grab the opponent and pull himself to them (only half way if they block).
// Special (tattoo glows when the meter is full): he spins the whip three times (wind-up only), then lashes HIGH
//        (head and chest: crouch under it) or LOW (the legs: jump over it), at random. If it connects, the opponent
//        is dragged to him and stunned.
// See ayz.ron for what each field means; finisher_move / boost_reach / pull_self / pull_foe / pull_gap / low_hitbox /
// leap / hits are explained in src/sim/data.rs.
(
    name: "Junkhead",
    subtitle: Some("Producer of his own crack"),
    // what Light, Heavy and Special do, shown in the character select
    blurbs: ["Whips from both sides, then a jump kick. If the kick lands the next whip reaches further.", "Lashes out, grabs the enemy and pulls himself to them. Works in the air too.", "Spins the whip, then lashes high or low at random. If it connects the enemy is dragged in and stunned."],
    sprites: Some("junkhead"),
    color: (0.85, 0.58, 0.32),
    walk_speed: 210,
    jump_speed: 1050,
    // the CPU starts whipping from 65 px away (his whip reaches about 77 px centre to centre)
    cpu_range: Some(65),
    // whip layers are drawn over his body
    whip: true,
    // a connected heavy or special cancels into Light at once, and the next three lights are quick
    light_after_heavy: true,
    // up to three air attacks per jump: air lights chain, and the air heavy can end the chain
    air_chain: Some(3),
    // a third less health than the others (667 of 1000)
    health: Some(667),
    // the special meter fills at 43% of the normal rate
    meter_gain_pct: Some(43),
    special_mark: Some(Scar(color: (0.78, 0.16, 0.16), glow: (1.0, 0.36, 0.3))),
    // Junkhead's own voice, on top of the game's generic sounds (assets/sfx/voice_junkhead_*.wav, never the same one twice in a row)
    voice: (dash: Some("voice_junkhead_dash"), hurt: Some("voice_junkhead_hurt"), ko: Some("voice_junkhead_died"), block: Some("voice_junkhead_successful_block"),
            guard_break: Some("voice_junkhead_gettingstunned"), smash: Some("voice_junkhead_stomp"), win: Some("voice_junkhead_victory")),
    moves: [
        (name: "Whip", sfx: (cast: Some("whip_crack"), hit: Some("slap")), button: Light, crouching: false, anim: Punch, walk_pct: 60, boost_reach: 45,
         startup: 4, active: 3, recovery: 8, damage: 28, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 10, y: 26, w: 64, h: 14)),
        (name: "Low Whip", sfx: (cast: Some("whip_crack"), hit: Some("slap")), button: Light, crouching: true, anim: Soft, walk_pct: 0,
         startup: 5, active: 3, recovery: 8, damage: 24, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 10, y: 0, w: 74, h: 10)),
        // finisher of a light combo; must come after the normal Whip
        (name: "Jump Kick", sfx: (hit_voice: Some("voice_junkhead_combo_landed")), button: Light, crouching: false, anim: Kicks, walk_pct: 0, finisher_move: true,
         leap: 700, leap_vx: 130,
         startup: 6, active: 8, recovery: 12, damage: 40, hitstun: 16, blockstun: 10, knockback: 3, hitstop: 5,
         hitbox: (x: 6, y: -4, w: 30, h: 30)),
        (name: "Whip Pull", sfx: (cast: Some("whip_crack"), hit_voice: Some("voice_junkhead_heavy_landed"), voice_lock: 54), button: Heavy, crouching: false, anim: Hard, walk_pct: 0,
         pull_self: true, pull_gap: 24, cooldown: 180, guard_hits: Some(2),
         startup: 14, active: 4, recovery: 26, damage: 60, hitstun: 18, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 10, y: 22, w: 125, h: 16), assist: 12),
        (name: "Whip Spin", sfx: (cast: Some("whip_crack"), hit: Some("slap")), button: Light, crouching: false, air: true, anim: Soft, walk_pct: 100,
         hover: true, hits: 2, hit_gap: 8,
         startup: 5, active: 5, recovery: 10, damage: 26, hitstun: 14, blockstun: 8, knockback: 0, hitstop: 3,
         hitbox: (x: -48, y: -6, w: 96, h: 72)),
        // the whip catches the opponent (28 damage) and pulls him through the air right up to them, then he plunges and
        // smashes the floor where he arrives (27 more): the two halves make up the old 55
        (name: "Air Whip Pull", sfx: (cast: Some("whip_crack"), hit_voice: Some("voice_junkhead_heavy_landed"), voice_lock: 54), button: Heavy, crouching: false, air: true, anim: Hard, walk_pct: 100,
         pull_self: true, pull_gap: 24, smash_damage: 27, cooldown: 180, guard_hits: Some(2),
         startup: 12, active: 4, recovery: 18, damage: 28, hitstun: 18, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 10, y: -80, w: 125, h: 110), assist: 12),
        // the special works in the air too: he hangs there while he spins and the lash goes high or low at the ground (heights are measured from the floor), so it's crouched or jumped like the ground one
        (name: "Air Whip Storm", unblockable: true, sfx: (cast: Some("whip_crack"), hit: Some("slap"), voice: Some("voice_junkhead_specialcast"), voice_lock: 84), button: Special, crouching: false, air: true, anim: Summon, walk_pct: 0,
         hover: true, world_y: true, pull_foe: true, pull_gap: 22, committed: true, commit_at: Some(2),
         startup: 32, active: 8, recovery: 24, damage: 150, hitstun: 70, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 8, y: 42, w: 190, h: 22), assist: 30,
         low_hitbox: Some((x: 8, y: 0, w: 190, h: 20))),
        (name: "Whip Storm", unblockable: true, sfx: (cast: Some("whip_crack"), hit: Some("slap"), voice: Some("voice_junkhead_specialcast"), voice_lock: 84), button: Special, crouching: false, anim: Summon, walk_pct: 0,
         pull_foe: true, pull_gap: 22, committed: true, commit_at: Some(2),
         startup: 32, active: 8, recovery: 24, damage: 150, hitstun: 70, blockstun: 12, knockback: 0, hitstop: 6,
         // high: head and chest (a crouching fighter, 40 px tall, is under it)
         hitbox: (x: 8, y: 42, w: 190, h: 22), assist: 30,
         // low: the legs (a fighter in the air is over it)
         low_hitbox: Some((x: 8, y: 0, w: 190, h: 20))),
    ],
)
