// The Haymaker: a scythe fighter with long reach and dark red effects. Drawings come from `python tools/gen_haymaker.py`.
// Light: scythe slashes; the third hit is a lunge, a short jump at the enemy that slashes as he lands.
// Heavy: hooks the enemy with the blade and drags them in. Light follows at once if it lands.
// Special: spins the scythe round him three times, then red energy launches him up and blasts anyone close.
// See ayz.ron for what each field means; launch, hits and pull_foe are in src/sim/data.rs.
(
    name: "Haymaker",
    subtitle: Some("Reaps what you sow"),
    sprites: Some("haymaker"),
    blurbs: ["Long scythe slashes, then a lunge: a short jump at the enemy that slashes as he lands.", "Hooks the enemy with the blade and drags them to him. Light follows at once if it lands.", "Spins the scythe round him three times, then red energy launches him up and blasts anyone close."],
    color: (0.62, 0.12, 0.14),
    spark_color: Some((0.62, 0.06, 0.1)),
    walk_speed: 190,
    jump_speed: 1050,
    // Attack reach reduced by 20%; damage reduced by 10% (rounded to whole units).
    cpu_range: Some(70),
    // the CPU holds him at the edge of his reach: it steps back when the enemy gets closer
    cpu_spacing: true,
    // the light swings have in-between drawings (`punch_mid_*`): out, strike, back
    punch_tweens: true,
    moves: [
        // two swings that alternate while it's spammed: an overhead hack, then a rising backhand
        (name: "Scythe Slash", button: Light, crouching: false, anim: Punch, walk_pct: 40,
         startup: 5, active: 4, recovery: 9, damage: 31, hitstun: 14, blockstun: 9, knockback: 2, hitstop: 4,
         hitbox: (x: 10, y: 14, w: 72, h: 32), assist: 5),
        (name: "Low Sweep", button: Light, crouching: true, anim: Soft, walk_pct: 0,
         startup: 6, active: 4, recovery: 9, damage: 27, hitstun: 14, blockstun: 9, knockback: 2, hitstop: 4,
         hitbox: (x: 10, y: 0, w: 74, h: 12)),
        // finisher of a light combo; must come after the normal slash
        (name: "Reaping Lunge", button: Light, crouching: false, anim: Kicks, walk_pct: 0, finisher_move: true,
         leap: 560, leap_vx: 260,
         startup: 5, active: 10, recovery: 10, damage: 41, hitstun: 18, blockstun: 10, knockback: 3, hitstop: 5,
         hitbox: (x: 6, y: 0, w: 62, h: 40)),
        (name: "Air Slash", button: Light, crouching: false, air: true, anim: Soft, walk_pct: 100,
         startup: 5, active: 5, recovery: 9, damage: 27, hitstun: 14, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 5, y: -14, w: 66, h: 48)),
        (name: "Reaper's Hook", button: Heavy, crouching: false, anim: Hard, walk_pct: 0,
         pull_foe: true, pull_gap: 30, cooldown: 173, guard_hits: Some(2), light_cancel: true,
         startup: 7, active: 4, recovery: 20, damage: 50, hitstun: 26, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 11, y: 18, w: 94, h: 20), assist: 8),
        (name: "Air Hook", button: Heavy, crouching: false, air: true, anim: Hard, walk_pct: 100,
         pull_foe: true, pull_gap: 30, cooldown: 173, guard_hits: Some(2), light_cancel: true,
         startup: 6, active: 4, recovery: 15, damage: 41, hitstun: 24, blockstun: 12, knockback: 0, hitstop: 6,
         hitbox: (x: 8, y: -14, w: 85, h: 44), assist: 8),
        // three turns of the scythe (36 each), then the red launch, whose blast hits anyone close for 41
        (name: "Reaping Spin", button: Special, crouching: false, anim: Reap, walk_pct: 0,
         hits: 3, hit_gap: 11, launch: 1250, launch_damage: 41, launch_radius: 64, committed: true,
         startup: 5, active: 6, recovery: 30, damage: 36, hitstun: 16, blockstun: 10, knockback: 0, hitstop: 4,
         hitbox: (x: -50, y: 0, w: 100, h: 54)),
    ],
)
