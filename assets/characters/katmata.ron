// Katmata, The Crepe: a man in a green cap, a white tee and blue jeans with a lit cigarette in his mouth.
// He carries five cigarettes (the lit one and four in a pack on his belt) and rolls a new one every second while he
// isn't fighting; the row under his health bar shows how many are left.
// Light: a combo of three. He flicks the lit cigarette at the enemy twice (each costs one), then takes another from
//        the pack, puts it in his mouth and lights it. The third light is an iced latte thrown at them: a bit of
//        damage, and it spills where it lands. Anyone but him standing on the spill for the next two seconds has their
//        controls reversed (left and right, up and down, the rolls). With no cigarettes left he flicks his lighter at
//        them instead.
// Heavy: he opens a laptop and codes for almost a second, and a large glitched area appears around the enemy for five
//        seconds: inside it they move at a third of their speed, can't block, do half damage, and lose a little health (4 every
//        third of a second). Four seconds of
//        cooldown: from the cast if it never lands, or from when the zone ends if it does.
// Special (the ember of his cigarette glows when the meter is full): two robot sub-agents fight for him. They walk up,
//        dash in from a distance, throw a pair of punches, then roll away or through. One light attack kills one; a ground pound doesn't.
// See ayz.ron for what each field means; `cigarettes`, `cig_cost` and `out_of_cigs`, `zone` and the minion field
// `agent` are explained in src/sim/data.rs.
(
    name: "Katmata",
    // shown under his name in the character select only
    subtitle: Some("The Crepe"),
    // what Light, Heavy and Special do, shown in the character select
    blurbs: ["Flicks two cigarettes (one each), then an iced latte whose spill reverses the enemy's controls.", "Opens a laptop and codes: a big glitched area round the enemy slows them, stops blocking, halves damage.", "Summons two robot sub-agents that dash in and punch. One light attack kills one."],
    sprites: Some("katmata"),
    color: (0.5, 0.78, 0.45),
    walk_speed: 200,
    jump_speed: 1050,
    cigarettes: Some((max: 5, roll_frames: 45)),
    // the CPU keeps its distance and throws cigarettes (and drops the glitch on you) instead of walking in
    keeps_distance: true,
    special_mark: Some(Scar(color: (0.9, 0.4, 0.1), glow: (1.0, 0.6, 0.2))),
    moves: [
        // the toss: cigarettes one after the other, fast, no relighting in between
        (name: "Cigarette Toss", sfx: (cast: Some(""), launch: Some("flick")), button: Light, crouching: false, anim: Toss, walk_pct: 40, cig_cost: 1, combo_step: Some(0),
         startup: 4, active: 2, recovery: 8, damage: 33, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 3,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 22, y: 36, aim_y: 36, travel_frames: 1, lifetime: 45, size: (8, 4), image: Some("cigarette"), summon_image: Some("none"), speed: 6))),
        (name: "Cigarette Toss 2", sfx: (cast: Some(""), launch: Some("flick")), button: Light, crouching: false, anim: Toss, walk_pct: 40, cig_cost: 1, combo_step: Some(1),
         startup: 4, active: 2, recovery: 8, damage: 33, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 3,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 22, y: 36, aim_y: 36, travel_frames: 1, lifetime: 45, size: (8, 4), image: Some("cigarette"), summon_image: Some("none"), speed: 6))),
        // the fifth and last: thrown like the rest, then a new one into his mouth, lit; after it he fights with the lighter
        // until the whole pack is rolled again
        (name: "Last Cigarette", sfx: (cast: Some(""), launch: Some("flick")), button: Light, crouching: false, anim: Throw, walk_pct: 40, cig_cost: 1, last_cig: true,
         startup: 6, active: 2, recovery: 46, damage: 33, hitstun: 12, blockstun: 8, knockback: 2, hitstop: 3,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 22, y: 36, aim_y: 36, travel_frames: 1, lifetime: 45, size: (8, 4), image: Some("cigarette"), summon_image: Some("none"), speed: 6))),
        // the combo's last: the iced latte, which spills where it lands
        (name: "Iced Latte", sfx: (hit: Some("splash"), block: Some("splash")), button: Light, crouching: false, anim: Latte, walk_pct: 0, finisher_move: true,
         zone: Some((kind: Spill, half_width: 22, life: 120)),
         startup: 14, active: 2, recovery: 22, damage: 51, hitstun: 16, blockstun: 8, knockback: 2, hitstop: 4,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         projectile: Some((x: 20, y: 34, aim_y: 34, travel_frames: 1, lifetime: 34, size: (10, 12), image: Some("icedcup"), summon_image: Some("none"), speed: 5, upright: true))),
        // close up, or out of cigarettes: a flick of the lighter (it costs nothing)
        (name: "Lighter Flick", sfx: (cast: Some("flick")), button: Light, crouching: false, anim: Soft, walk_pct: 40, out_of_cigs: true, within: Some(50),
         startup: 5, active: 3, recovery: 12, damage: 18, hitstun: 10, blockstun: 6, knockback: 1, hitstop: 3,
         hitbox: (x: 8, y: 24, w: 22, h: 14)),
        (name: "Low Flick", sfx: (cast: Some("flick")), button: Light, crouching: true, anim: Soft, walk_pct: 0,
         startup: 6, active: 3, recovery: 10, damage: 15, hitstun: 10, blockstun: 6, knockback: 1, hitstop: 3,
         hitbox: (x: 8, y: 0, w: 24, h: 12)),
        (name: "Air Flick", sfx: (cast: Some("flick")), button: Light, crouching: false, air: true, anim: Soft, walk_pct: 100,
         startup: 4, active: 6, recovery: 6, damage: 18, hitstun: 10, blockstun: 6, knockback: 1, hitstop: 3,
         hitbox: (x: 6, y: 0, w: 26, h: 26)),
        // the laptop: he codes, and a glitched area appears around the enemy (it lands when he's done typing)
        (name: "Push to Prod", sfx: (cast: Some("bleep")), button: Heavy, crouching: false, anim: Read, walk_pct: 30, cooldown: 240,
         zone: Some((kind: Glitch, half_width: 80, life: 300, at_frame: 54, tick_damage: 4, tick_every: 20)),
         startup: 54, active: 1, recovery: 16, damage: 0, hitstun: 0, blockstun: 0, knockback: 0, hitstop: 0,
         hitbox: (x: 0, y: 0, w: 0, h: 0)),
        // two robots
        (name: "Sub-Agents", sfx: (cast: Some("summon_digital"), launch: Some("bleep")), button: Special, crouching: false, anim: Summon, walk_pct: 0, guard_hits: Some(0),
         startup: 24, active: 3, recovery: 24, damage: 30, hitstun: 14, blockstun: 8, knockback: 3, hitstop: 4,
         hitbox: (x: 0, y: 0, w: 0, h: 0),
         minions: Some((agent: true, count: 2, lifetime: 600, interval: 36, speed: 3, reach: 18, health: 48))),
    ],
)
