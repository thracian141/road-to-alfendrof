    maps: [
        (
            id: "the_city",
            name: "The City",
            image: "campaign_maps/campaign_map1_istanbul.png",
            levels: [
                (name: "Ataşehir", at: (339, 79), stage: "Istanbul Courtyard", rival: "Katmata", difficulty: 1),
